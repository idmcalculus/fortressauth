# Server Configuration
PORT=3000
HOST=0.0.0.0
# Set to true if the server must fail instead of selecting the next free port.
# STRICT_PORT=false
NODE_ENV=development

# Database
# SQLite (default for development)
DATABASE_URL=./fortress.db
# PostgreSQL example: postgresql://user:password@localhost:5432/fortressauth
# MySQL example: mysql://user:password@localhost:3306/fortressauth

# Public URL (used for email links)
BASE_URL=http://localhost:3000

# Security
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=

# Frontend deployment notes:
# If API and frontend use different top-level domains,
# set both session and CSRF cookies to SameSite=None and keep Secure=true:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# CSRF_COOKIE_SECURE=true
# CSRF_COOKIE_SAMESITE=none
#
# If API and frontend share the same top-level domain (recommended, e.g. api.fortressauth.com + fortressauth.com),
# use:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# CSRF_COOKIE_SECURE=true
# CSRF_COOKIE_SAMESITE=lax

# CSRF Protection
CSRF_COOKIE_NAME=fortress_csrf
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax
# CSRF_COOKIE_DOMAIN=
CSRF_HEADER_NAME=x-csrf-token
CSRF_TOKEN_TTL_MS=7200000

# Breached Password Checks (Have I Been Pwned)
BREACHED_PASSWORD_CHECK=false
# BREACHED_PASSWORD_API_URL=https://api.pwnedpasswords.com
# BREACHED_PASSWORD_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=info

# CORS (comma-separated origins)
# When not set, defaults to: BASE_URL origin, localhost:3000, localhost:3001, localhost:5173, localhost:5174
# For production, explicitly set your allowed origins:
# CORS_ORIGINS=https://fortressauth.com,https://react-demo.fortressauth.com
#
# For development with multiple frontend apps:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
#
# Note: The server uses credentials: true, so client apps must use credentials: 'include' in fetch requests.
# All FortressAuth web SDKs (React, Vue, Svelte, Angular) handle this automatically.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Redis (optional, for distributed rate limiting)
# REDIS_URL=redis://localhost:6379

# Metrics
METRICS_ENABLED=true

# Email Provider Configuration
# Options: 'console' (logs to terminal), 'resend', 'ses', 'sendgrid', 'smtp'
EMAIL_PROVIDER=console

# Resend Configuration (required when EMAIL_PROVIDER=resend)
# Get your API key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=Your App Name

# AWS SES Configuration (required when EMAIL_PROVIDER=ses)
# SES_REGION=us-east-1
# SES_FROM_ADDRESS=noreply@yourdomain.com
# SES_FROM_NAME=Your App Name
# SES_ACCESS_KEY_ID=AKIA...
# SES_SECRET_ACCESS_KEY=...
# SES_SESSION_TOKEN=...

# SendGrid Configuration (required when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM_ADDRESS=noreply@yourdomain.com
# SENDGRID_FROM_NAME=Your App Name

# SMTP Configuration (required when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp_user
# SMTP_PASS=smtp_password
# SMTP_FROM_ADDRESS=noreply@yourdomain.com
# SMTP_FROM_NAME=Your App Name
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_TLS_SERVERNAME=smtp.example.com
# Native desktop OAuth (exact redirect URI allowlist)
# NATIVE_CLIENT_ID=wraith
# NATIVE_REDIRECT_URIS=wraith://auth/callback
# NATIVE_AUTHORIZATION_CODE_TTL_MS=60000
# Native bearer sessions are separate from browser cookie sessions. Default: 24 hours.
# Allowed range: 5 minutes to 30 days. Expiry requires system-browser reauthentication.
# NATIVE_SESSION_TTL_MS=86400000
# Multiple applications (preferred). Omitted resourceAudiences means no resource access:
# NATIVE_CLIENTS_JSON=[{"clientId":"desktop-app","redirectUris":["desktop-app://auth/callback"],"resourceAudiences":["account-api"]},{"clientId":"other-app","redirectUris":["http://127.0.0.1:43119/callback"]}]

# Public resource-server registration. Both client and resource allowlists must agree.
# RESOURCE_SERVERS_JSON=[{"audience":"account-api","enabled":true,"allowedClientIds":["desktop-app"],"rateLimit":{"maxTokens":120,"windowMs":60000}}]
# RESOURCE_INTROSPECTION_GLOBAL_MAX_TOKENS=2000
# RESOURCE_INTROSPECTION_GLOBAL_WINDOW_MS=60000
# RESOURCE_INTROSPECTION_MAX_BODY_BYTES=1024
# RESOURCE_INTROSPECTION_AUDIT_RETENTION_DAYS=90
# TRUSTED_PROXY_HOP_COUNT=0
# RESOURCE_SERVER_CREDENTIALS_JSON is secret configuration. Inject its complete JSON value from the
# production secret manager; never place it in this file, public config, source, logs, or a client.
