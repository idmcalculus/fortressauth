{
  "name": "@fortressauth/desktop-sdk",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idmcalculus/fortressauth.git",
    "directory": "packages/desktop-sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
