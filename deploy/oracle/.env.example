# Compose settings for deploy/oracle/docker-compose.yml. Copy to .env on the
# VM and chmod 600. The server's own settings go in app.env.

# Public names Caddy serves and gets certificates for, comma-separated.
# Start with a spare name (e.g. oci-api.fortressauth.com) and add
# api.fortressauth.com when you move DNS over.
APP_DOMAIN=api.fortressauth.com

# Image the app runs. The deploy workflow rewrites this line on every
# deploy; the value here only has to be non-empty until the first one.
FORTRESS_IMAGE=ghcr.io/idmcalculus/fortressauth-server:set-by-first-deploy

# Hex only, so it can sit in DATABASE_URL unescaped: openssl rand -hex 32
POSTGRES_PASSWORD=

# Keep-alive (see README.md). Delete this line to turn it off.
COMPOSE_PROFILES=keepalive
# About 25% of the VM's RAM: 3072 for 12 GB, 1536 for 6 GB.
KEEPALIVE_MEMORY_MB=3072

# Nightly backups (backup.sh). Local dumps older than this are deleted.
BACKUP_KEEP_DAYS=14
# Optional off-VM copy: a write-only pre-authenticated request URL for an
# OCI Object Storage bucket (it ends in /o/). Leave empty to keep backups on
# the VM only.
BACKUP_PAR_URL=
