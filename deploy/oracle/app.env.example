# FortressAuth server settings for deploy/oracle/docker-compose.yml. Copy to
# app.env on the VM and chmod 600. Never commit the filled-in file.
#
# Compose sets NODE_ENV, HOST, PORT, DATABASE_URL, TRUSTED_PROXY_HOP_COUNT
# and the cookie Secure flags itself, so those keys are ignored here.
#
# Leave unused settings commented out rather than empty: several are checked
# as URLs or JSON, and an empty value stops the server at startup.
#
# scripts/aws-export-app-env.sh prod <file> copies the current secret values
# out of AWS Secrets Manager in this format.

BASE_URL=https://fortressauth.com
CORS_ORIGINS=https://fortressauth.com,https://react-demo.fortressauth.com
COOKIE_SAMESITE=lax
CSRF_COOKIE_SAMESITE=lax
LOG_LEVEL=info
BREACHED_PASSWORD_CHECK=true
# Nothing scrapes Prometheus metrics on this VM, so keep /metrics closed.
METRICS_ENABLED=false

# --- Email ------------------------------------------------------------------
# SES from outside AWS needs an IAM user's access key, created in the AWS
# account that owns the fortressauth.com SES identity. See README.md.
EMAIL_PROVIDER=ses
SES_REGION=eu-west-1
SES_FROM_ADDRESS=noreply@fortressauth.com
SES_FROM_NAME=FortressAuth
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM_ADDRESS=noreply@fortressauth.com
EMAIL_FROM_NAME=FortressAuth
# Do not set SES_CONFIGURATION_SET_NAME. That configuration set belongs to
# the AWS Pulumi stack and is deleted with it.

# Resend instead of SES:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# --- Native clients and resource servers -------------------------------------
# Uncomment these three together. The server will not start with an enabled
# resource server that has no credential. The first two match the AWS prod
# stack config; the credential comes from Secrets Manager
# (fortressauth-prod/app/RESOURCE_SERVER_CREDENTIALS_JSON).
# NATIVE_CLIENTS_JSON='[{"clientId":"wraith","redirectUris":["wraith://auth/callback"],"resourceAudiences":["wraith-api"]}]'
# RESOURCE_SERVERS_JSON='[{"audience":"wraith-api","enabled":true,"allowedClientIds":["wraith"]}]'
# RESOURCE_SERVER_CREDENTIALS_JSON='[{"audience":"wraith-api","credentials":[{"credentialId":"...","secret":"..."}]}]'

# --- OAuth providers ----------------------------------------------------------
# Uncomment the providers you use. The others follow the same pattern:
# <NAME>_CLIENT_ID, <NAME>_CLIENT_SECRET and <NAME>_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.fortressauth.com/auth/oauth/google/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_SECRET=
# APPLE_REDIRECT_URI=https://api.fortressauth.com/auth/oauth/apple/callback
